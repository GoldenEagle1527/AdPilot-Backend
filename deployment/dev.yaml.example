listen_host: "0.0.0.0"
listen_port: 8300

cors_origins:
  - "*"

postgres:
  host: "127.0.0.1"
  port: 5432
  database: "ad_pilot"
  user: "ad_pilot"
  password: "ad_pilot"

redis:
  host: "127.0.0.1"
  port: 6379
  password: null

token_ttl_seconds: 604800
jwt_secret: "replace-dev-jwt-secret-min-32-characters"
db_pool_size: 10
db_pool_max_overflow: 10
db_pool_timeout: 30
