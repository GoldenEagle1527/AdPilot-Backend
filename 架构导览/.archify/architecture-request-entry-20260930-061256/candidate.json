  "cards": [
    {
      "dot": "cyan",
      "title": "请求怎么进来",
      "items": [
        "调用方把请求交给接口进程。成功和失败都收成同一套响应。",
        "登录、健康检查、巨量授权回调不查会话。别的接口要带令牌。",
        "令牌先解开，再按会话号到内存库确认这次登录还在。"
      ]
    },
    {
      "dot": "emerald",
      "title": "进程旁边有什么",
      "items": [
        "数据库存业务表。内存库 0 号库存登录会话。",
        "后台队列用 1 号库，结果用 2 号库，不跟会话混放。",
        "上传文件进对象存储，不写进业务表。"
      ]
    },
    {
      "dot": "amber",
      "title": "默认不打巨量",
      "items": [
        "配置缺省是假客户端，启动不会访问开放平台。",
        "标准投放草稿和端原生任务只写本地表。",
        "漫剧同步在另一个进程，不在这一次请求里面。"
      ]
    }
  ],
